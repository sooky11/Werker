# ============================================================
# Werker - voorbeeldconfiguratie
# Kopieer dit bestand naar .env en vul de waarden in.
# Zet hier GEEN echte geheimen in dit voorbeeldbestand.
# ============================================================

# ---- Claude API ----------------------------------------------
# Sleutel voor de Claude API (classificatie en conceptantwoorden).
ANTHROPIC_API_KEY=

# ---- Opslag en prijzen ---------------------------------------
# Pad naar de SQLite-database in de container (map ./data op de host).
WERKER_DB=/data/werker.db
# Google Sheet als CSV-export. Als deze waarde gevuld is, wordt het lokale bestand genegeerd.
WERKER_PRICES_CSV_URL=
# Lokaal prijsbestand (YAML). Zet je prijslijst op de host als ./data/prices.yaml
# en gebruik dan WERKER_PRICES_FILE=/data/prices.yaml.
WERKER_PRICES_FILE=/app/prices.example.yaml

# ---- Mail: IMAP/SMTP (kies IMAP of Gmail) --------------------
WERKER_IMAP_HOST=
WERKER_IMAP_USER=
WERKER_IMAP_PASSWORD=
WERKER_SMTP_HOST=
# Afzenderadres voor verstuurde antwoorden (gebruikt door IMAP en Gmail).
WERKER_SENDER_ADDRESS=

# ---- Mail: Gmail (alleen gebruikt als WERKER_IMAP_HOST leeg is) ----
# Pad in de container naar het OAuth-token; plaats token.json in ./data op de host
# en gebruik dan WERKER_GMAIL_TOKEN=/data/token.json. Laat leeg als je IMAP gebruikt.
WERKER_GMAIL_TOKEN=

# ---- Eigen adressen en spam ----------------------------------
# Komma-gescheiden eigen adressen; berichten van deze adressen worden overgeslagen.
WERKER_OWN_ADDRESSES=
# Komma-gescheiden adressen die als spam gelabeld worden.
WERKER_BLOCKLIST=

# ---- Automatisch verzenden (kill switch) ---------------------
# Laat dit op false staan totdat de evaluatie goed is.
WERKER_AUTOSEND=false
# Intents die automatisch mogen verzenden (komma-gescheiden).
WERKER_AUTOSEND_INTENTS=prijsvraag
# Minimale zekerheid van de classificatie voor automatisch verzenden (0 tot 1).
WERKER_MIN_CONFIDENCE=0.85
# Bedragen boven deze grens gaan altijd naar een mens (in euro's).
WERKER_MAX_AUTO_AMOUNT=500

# ---- WhatsApp Business Cloud API -----------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret van de Meta-app; wordt gebruikt om webhook-aanroepen te verifiëren.
WHATSAPP_APP_SECRET=
# Zelfgekozen tekst; moet exact gelijk zijn aan het veld "Verify token" in Meta.
WHATSAPP_VERIFY_TOKEN=

# ---- Inbox-webpagina -----------------------------------------
# Verplicht bij serve op 0.0.0.0. Kies een lang, uniek wachtwoord.
WERKER_UI_PASSWORD=
